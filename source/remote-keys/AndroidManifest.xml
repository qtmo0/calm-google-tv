<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.qtmo0.calmtv.remotekeys"
    android:versionCode="2"
    android:versionName="1.1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Android 11+ only lets us see apps we name here. -->
    <queries>
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.github.damontecres.wholphin" />
        <package android:name="com.zattoo.player" />
    </queries>

    <application android:label="Fernbedienungs-Tasten" android:allowBackup="false">
        <service
            android:name=".TastenService"
            android:label="Fernbedienungs-Tasten"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tasten" />
        </service>
    </application>
</manifest>
